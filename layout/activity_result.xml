<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F7F4EE">

    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESULT"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#17324D" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quiz Completed!"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#168A8A"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Score: 0 / 5"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#17324D"
        android:layout_marginTop="35dp" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Try Again!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#E58A32"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="45dp" />

    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="PLAY AGAIN"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#168A8A"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnHome"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="HOME"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5277A3" />

</LinearLayout>